{
  "id": "max-of-list",
  "title": "Maximum of n integers (first line n, second line the integers)",
  "time_limit_s": 10,
  "test_cases": [
    {"stdin": "3\n1 9 4\n", "expected_stdout": "9\n"},
    {"stdin": "4\n-5 -2 -9 -7\n", "expected_stdout": "-2\n"},
    {"stdin": "1\n42\n", "expected_stdout": "42\n"}
  ]
}
